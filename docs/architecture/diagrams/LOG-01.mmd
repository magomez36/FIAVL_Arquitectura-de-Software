classDiagram
direction LR
class Evento {
  <<entidad>>
  +string id
  +string title
  +string description
  +string category
  +string startAt
  +string endAt
  +string venueId
  +string[] artistIds
  +int priceCents
  +int capacity
  +boolean reservable
  +string image
}
class Artista {
  <<entidad>>
  +string id
  +string name
  +string bio
  +string country
  +string discipline
  +string image
}
class Sede {
  <<entidad>>
  +string id
  +string name
  +string address
  +string description
  +string accessibilityNotes
  +string image
}
class Credito {
  <<asociacionPersistente>>
  +string eventId
  +string artistId
  +int position
}
class Reserva {
  <<entidad>>
  +int id
  +string referenceHash
  +string eventId
  +int quantity
  +string status
  +string createdAt
  +string cancelledAt
}
class Valoracion {
  <<entidad>>
  +int id
  +int rating
  +string comment
}
class Disponibilidad {
  <<proyeccion>>
  +string eventId
  +int capacity
  +int reserved
  +int remaining
  +boolean reservable
}
class ResumenValoraciones {
  <<proyeccion>>
  +int total
  +int[5] distribution
  +number average
}
class AgendaLocal {
  <<navegador>>
  +string[] eventIds
}
class ReferenciasLocales {
  <<navegador>>
  +int version
  +StoredItem[] items
}
class PreferenciasLectura {
  <<navegador>>
  +int version
  +TextSize textSize
  +Contrast contrast
}
class RecorridoEditorial {
  <<navegador>>
  +string name
  +string purpose
